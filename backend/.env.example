NODE_ENV=development
PORT=3000

# Use either DATABASE_URL or the discrete DB_* variables.
# DATABASE_URL=postgres://lapercuy:change-me@localhost:5432/lapercuy
DB_HOST=localhost
DB_PORT=5432
DB_USER=lapercuy
DB_PASS=change-me
DB_NAME=lapercuy

STUDENT_JWT_SECRET=replace-with-a-long-random-student-secret
STAFF_JWT_SECRET=replace-with-a-long-random-staff-secret
COOKIE_SECRET=replace-with-a-long-random-cookie-secret
DEVICE_API_KEY=replace-with-random-device-key

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password

PUBLIC_BASE_URL=http://localhost:3000
SESSION_CODE_EXPIRY_MINUTES=5
CLAIMED_SESSION_EXPIRY_MINUTES=30
MAX_ACTIVE_ORDERS=30
KITCHEN_PARALLELISM=2
