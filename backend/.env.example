# ==============================================
# LaperCuy Backend — Environment Configuration
# ==============================================
# Copy this file to .env and adjust values for your local setup

# Server
PORT=3000
NODE_ENV=development

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=lapercuy_db

# JWT Secret — replace with a long, secure random string!
JWT_SECRET=lapercuy_super_secret_key_2026_ganti_ini
JWT_EXPIRES_IN=7d
