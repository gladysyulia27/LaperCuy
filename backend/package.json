{
  "name": "lapercuy-backend",
  "version": "1.0.0",
  "description": "LaperCuy Food Ordering App — Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prestart": "node scripts/migrate.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "setup-db": "node scripts/migrate.js && node scripts/seed.js",
